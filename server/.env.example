# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/crm

# JWT
JWT_SECRET=local-development-secret-change-me
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_ENABLED=false

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
TRUST_PROXY=false

# Optional seed overrides (development only)
SEED_ADMIN_EMAIL=admin@crm.local
SEED_ADMIN_PASSWORD=AdminDemo123!
SEED_SALES_EMAIL=sales@crm.local
SEED_SALES_PASSWORD=SalesDemo123!

# OpenAI (for AI features)
OPENAI_API_KEY=your-openai-api-key-here

# Hugging Face (free alternative for AI features)
HF_TOKEN=your-hugging-face-token-here
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2  # optional, defaults to this

# AI Provider (choose one: openai or huggingface)
AI_PROVIDER=openai  # or huggingface

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Redis (optional - for caching/sessions)
REDIS_URL=redis://localhost:6379
